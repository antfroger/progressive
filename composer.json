{
    "name": "antfroger/progressive",
    "description": "The library to progressively, quickly and simply enables new features",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/antfroger/Progressive",
    "authors": [
        {
            "name": "Antoine Froger",
            "email": "antfroger@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "friendsofphp/php-cs-fixer": "^3.26",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Progressive\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Progressive\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
